{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server",
        "--prefix",
        "backend"
      ],
      "port": 3101
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "portal"
      ],
      "port": 5183
    }
  ]
}