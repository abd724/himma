# Himma STAGING — non-secret configuration (copy to terraform.tfvars; that file is gitignored
# only because it carries the account id and domain the company chooses — no secrets ever).
environment                 = "staging"
expected_account_id         = "000000000000" # the STAGING workload account id (never the management account)
region                      = "me-central-1"
root_domain                 = "example.invalid" # company-controlled domain; hostnames become api.staging.<root> etc.
hostname_prefix             = "staging."
create_hosted_zone          = false
hosted_zone_id              = ""
github_repository           = "owner/himma"
image_tag                   = "bootstrap" # the pipeline sets the git SHA; first apply uses -target=module.registry (infra/README.md)
payments_mode               = "disabled" # "test" only after genuine Stripe TEST credentials are in the stripe/test secret
api_desired_count           = 1
worker_desired_count        = 1
tasks_in_public_subnets     = true  # cost mode: no NAT; tasks get public IPs behind strict security groups
nat_gateway_count           = 0
enable_interface_endpoints  = false
db_instance_class           = "db.t4g.small"
db_multi_az                 = false
db_backup_retention_days    = 7
db_deletion_protection      = true
db_skip_final_snapshot      = false
cognito_deletion_protection = false
log_retention_days          = 14
alert_email                 = ""
create_build_role           = true
