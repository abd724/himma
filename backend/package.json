{
  "name": "@himma/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Himma production backend (W4) \u2014 modular monolith on Fastify 5 + PostgreSQL. Slice 1: database and migration foundation.",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test --max-warnings=0",
    "test": "jest --runInBand",
    "db:new": "tsx scripts/db-new-migration.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:down": "tsx scripts/db-down.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:codegen": "tsx scripts/db-codegen.ts",
    "db:seed-admins": "tsx scripts/db-seed-admins.ts",
    "stripe:smoke": "tsx scripts/stripe-sandbox-smoke.ts",
    "bootstrap:admins": "tsx scripts/db-bootstrap-admins.ts",
    "start:api": "tsx scripts/start-api.ts",
    "start:worker": "tsx scripts/start-worker.ts",
    "db:provision-roles": "tsx scripts/db-provision-runtime-roles.ts",
    "dev:server": "tsx scripts/dev-server.ts",
    "dev:seed": "tsx scripts/dev-seed.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.0",
    "fastify": "^5.0.0",
    "jose": "^5.10.0",
    "kysely": "^0.28.0",
    "node-pg-migrate": "^8.0.0",
    "pg": "^8.16.0",
    "pino": "^10.1.0",
    "stripe": "^22.5.0",
    "tsx": "^4.20.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "kysely-codegen": "^0.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
