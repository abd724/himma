# Backend local development configuration — copy to `.env` and adjust.
# `.env` is gitignored; NEVER commit credentials (docs/25 §5).
#
# Development and test never read production configuration. Production
# receives DATABASE_URL from the managed secret store (docs/23 §10.3) and
# refuses to start from defaults.

NODE_ENV=development
PGHOST=localhost
PGPORT=5432
PGDATABASE=himma_backend_dev
# Defaults to the current OS user when unset (Homebrew PostgreSQL default).
#PGUSER=
#PGPASSWORD=

# ---------------------------------------------------------------------------
# W6-1 — PRODUCTION runtime contract (docs/37 §6). Placeholders only; real
# values are injected by the deployment environment / secret manager and
# NEVER committed. Production fails closed on every missing mandatory value.
# ---------------------------------------------------------------------------
# Mandatory in production (all roles):
#NODE_ENV=production
#RUNTIME_ROLE=api            # api | worker | maintenance | migrate
#DATABASE_URL=               # SECRET — role-specific credential: himma_api for
#                            # RUNTIME_ROLE=api, himma_worker for worker,
#                            # himma_maintenance_runner for maintenance,
#                            # the schema owner for migrate. Startup asserts
#                            # current_user matches the role and refuses on
#                            # mismatch (docs/37 §28).
# Mandatory for RUNTIME_ROLE=api:
#HOST=                       # explicit bind address (e.g. 0.0.0.0 in a container)
#PORT=
# Operational policy (defaults shown):
#LOG_LEVEL=info              # fatal|error|warn|info|debug|trace
#SHUTDOWN_DRAIN_MS=15000
# Payments (docs/37 §33): disabled (default) or test. There is NO live value —
# live enablement is the owner-gated PA-06 slice, never configuration.
#PAYMENTS_MODE=disabled
#STRIPE_SECRET_KEY=          # SECRET — TEST-mode key only; live keys are refused
#STRIPE_WEBHOOK_SECRET=      # SECRET
#STRIPE_WEBHOOK_SECRET_RETIRING=   # SECRET (rotation window only)
#PAYMENT_CHECKOUT_SUCCESS_URL=     # https, never a local address in production
#PAYMENT_CHECKOUT_CANCEL_URL=
# Identity (docs/36 ID-01/ID-02 — public values, not secrets):
#COGNITO_ISSUER=
#COGNITO_CLIENT_IDS=
#COGNITO_REFRESH_CLIENT_ID=
#PORTAL_ALLOWED_ORIGINS=
# Evidence object storage (docs/36 IN-06/VE-01 — all-or-none):
#EVIDENCE_S3_ENDPOINT=
#EVIDENCE_S3_REGION=
#EVIDENCE_S3_BUCKET=
#EVIDENCE_S3_ACCESS_KEY_ID=        # SECRET
#EVIDENCE_S3_SECRET_ACCESS_KEY=    # SECRET
#EVIDENCE_S3_KEY_PREFIX=
# Runtime-role provisioning (scripts/db-provision-runtime-roles.ts; injected
# only when running that command — never present in runtime processes):
#HIMMA_API_DB_PASSWORD=            # SECRET
#HIMMA_WORKER_DB_PASSWORD=         # SECRET
# W6-2 worker operational policy (RUNTIME_ROLE=worker; engineering defaults shown):
#WORKER_OUTBOX_POLL_MS=2000
#WORKER_OUTBOX_BATCH=100
#WORKER_OUTBOX_MAX_ATTEMPTS=8
#WORKER_PAYMENT_POLL_MS=30000
#WORKER_STATUS_PORT=            # optional minimal /internal/live listener
