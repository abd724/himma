# Provider Portal — STAGING build-time PUBLIC configuration (no secrets; values come from
# `terraform output frontend_build_env` in the staging account — infra/scripts/static-deploy.sh injects them).
VITE_API_BASE_URL=https://api.staging.<root_domain>
VITE_COGNITO_ISSUER=https://cognito-idp.me-central-1.amazonaws.com/<staging user pool id>
VITE_COGNITO_CLIENT_ID=<staging portal app client id>
VITE_PORTAL_AUTH_MODE=live
