# Customer App (Expo) — STAGING build-time PUBLIC configuration (no secrets; values come from
# `terraform output frontend_build_env` in the staging account). Product behaviour and production
# identifiers are unchanged; Apple/Google sign-in stay disabled until their real credentials exist
# (docs/36 ID-05…07).
EXPO_PUBLIC_API_URL=https://api.staging.<root_domain>
EXPO_PUBLIC_COGNITO_ISSUER=https://cognito-idp.me-central-1.amazonaws.com/<staging user pool id>
EXPO_PUBLIC_COGNITO_CLIENT_ID=<staging mobile app client id>
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
